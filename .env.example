# 可选：仅用于首次导入旧配置。新安装直接使用网页填写，无需此文件。
# 网页保存后以网页配置为准；Compose 默认不加载 .env。不要提交实际密钥。
BILI_BOT_AI_API_KEY=
BILI_BOT_AI_MODEL=
BILI_BOT_AI_BASE_URL=https://api.openai.com/v1
BILI_BOT_DATA_DIR=/data
BILI_BOT_TRANSCRIPTION_API_KEY=
BILI_BOT_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
BILI_BOT_TRANSCRIPTION_MODEL=whisper-1
BILI_BOT_TRANSCRIPTION_LANGUAGE=zh
